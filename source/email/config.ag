guard Attachment: {
	filename: string,
	mime: string,
	data: binary
};

guard STMPTLSOption:
	"IMPLICIT" |
	"EXPLICIT";

guard Mailbox: {
	address: string,
	name?: string
};

guard MailerOptions: {
	smtp: {
		hostname: string,
		port: number,
		username: string,
		password: string,
		timeout_seconds?: integer(1,60),
		tls?: STMPTLSOption
	},
	defaults?: {
		sender?: Mailbox,
		to?: Mailbox | Mailbox[],
		from?: Mailbox | Mailbox[],
		reply?: Mailbox | Mailbox[],
		cc?: Mailbox | Mailbox[],
		bcc?: Mailbox | Mailbox[]
	}
};
