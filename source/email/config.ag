guard Attachment: {
	filename: string,
	mime: string,
	data: binary
};

guard STMPTLSOption:
	"IMPLICIT" |
	"EXPLICIT";

guard Mailbox: {
	address: string,
	name?: string
};

guard MailerOptions: {
	smtp: {
		hostname: string,
		port: number,
		username: string,
		password: string,
		timeout_seconds?: integer(1,60),
		tls?: STMPTLSOption
	},
	defaults?: {
		to_address?: string,
		to_name?: string,
		from_address?: string,
		from_name?: string,
		reply_address?: string,
		reply_name?: string
	}
};
